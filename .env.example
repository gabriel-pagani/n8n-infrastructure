# =================================
#               N8N
# =================================
# Ask n8n AI
N8N_AI_ASSISTANT_BASE_URL=  # Base URL of the AI assistant service, specified as https://ai-assistant.n8n.io . Required if you self-host n8n and want to enable Ask n8n AI.

# Binary data
N8N_AVAILABLE_BINARY_DATA_MODES=  # A comma separated list of available binary data modes.
N8N_BINARY_DATA_DATABASE_MAX_FILE_SIZE=  # Maximum size (in MiB) of a single file n8n stores when N8N_DEFAULT_BINARY_DATA_MODE is database. Can't exceed 1024, the limit of a database column. Storing a larger file fails.
N8N_BINARY_DATA_STORAGE_PATH=  # The path where n8n stores binary data.
N8N_DEFAULT_BINARY_DATA_MODE=  # The default binary data mode. default keeps binary data in memory. Set to filesystem to use the filesystem, s3 to use AWS S3, azure to use Azure Blob Storage, or database to use the DB. Note that binary data pruning operates on the active binary data mode. For example, if your instance stored data in S3, and you later switched to filesystem mode, n8n only prunes binary data in the filesystem. This may change in future.

# Credentials
CREDENTIALS_OVERWRITE_DATA=  # Overwrites for credentials.
CREDENTIALS_OVERWRITE_ENDPOINT=  # The API endpoint to fetch credentials.
CREDENTIALS_OVERWRITE_PERSISTENCE=  # Enable database persistence for credential overwrites. Required for multi-instance or queue mode to propagate overwrites to workers through a publish/subscribe approach.
CREDENTIALS_DEFAULT_NAME=  # The default name for credentials.

# Database
DB_TYPE=  # The database to use.
DB_TABLE_PREFIX=  # Prefix to use for table names.
DB_PING_INTERVAL_SECONDS=  # How often, in seconds, n8n pings the database to check that the connection is still alive.
DB_PING_TIMEOUT_MS=  # How long, in milliseconds, n8n waits for a single ping to respond before counting it as a failure. Falls back to the deprecated N8N_DB_PING_TIMEOUT if that's set.
DB_PING_MAX_FAILURES_BEFORE_RECOVERY=  # How many pings in a row must fail before n8n treats the connection as lost and starts recovery.
DB_RECOVERY_BACKOFF_MIN_MS=  # How long, in milliseconds, n8n waits before its first recovery attempt. Each retry waits longer (exponential backoff).
DB_RECOVERY_BACKOFF_MAX_MS=  # The longest, in milliseconds, n8n waits between recovery attempts. This caps the backoff. Must be greater than or equal to DB_RECOVERY_BACKOFF_MIN_MS.
DB_CONNECTION_ACQUISITION_TIMEOUT_MS=  # How long, in milliseconds, a query waits while recovery is in progress before failing fast with an error. Set to 0 to wait indefinitely. Applies to PostgreSQL only.
DB_POSTGRESDB_DATABASE=  # The name of the PostgreSQL database.
DB_POSTGRESDB_HOST=  # The PostgreSQL host.
DB_POSTGRESDB_PORT=  # The PostgreSQL port.
DB_POSTGRESDB_USER=  # The PostgreSQL user.
DB_POSTGRESDB_PASSWORD=  # The PostgreSQL password.
DB_POSTGRESDB_POOL_SIZE=  # Control how many parallel open Postgres connections n8n should have. Increasing it may help with resource utilization, but too many connections may degrade performance.
DB_POSTGRESDB_CONNECTION_TIMEOUT=  # Postgres connection timeout (ms).
DB_POSTGRESDB_IDLE_CONNECTION_TIMEOUT=  # Amount of time before an idle connection is eligible for eviction for being idle.
DB_POSTGRESDB_MAX_CONNECTION_LIFETIME_MS=  # How long, in milliseconds, n8n keeps a pooled connection before recycling it. Recycling old connections helps avoid stale connections that the database or network dropped without n8n noticing. The default is one hour. Set to 0 to disable recycling.
DB_POSTGRESDB_KEEP_ALIVE=  # Whether to enable TCP keep-alive on connections. Keep-alive lets n8n notice a dead connection without having to run a query first.
DB_POSTGRESDB_KEEP_ALIVE_INITIAL_DELAY_MS=  # How long, in milliseconds, n8n waits before sending the first TCP keep-alive probe on a connection.
DB_POSTGRESDB_SCHEMA=  # The PostgreSQL schema.
DB_POSTGRESDB_SSL_ENABLED=  # Whether to enable SSL. Automatically enabled if DB_POSTGRESDB_SSL_CA, DB_POSTGRESDB_SSL_CERT or DB_POSTGRESDB_SSL_KEY is set to a non-empty value, or if DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED is set to false.
DB_POSTGRESDB_SSL_CA=  # The PostgreSQL SSL certificate authority.
DB_POSTGRESDB_SSL_CERT=  # The PostgreSQL SSL certificate.
DB_POSTGRESDB_SSL_KEY=  # The PostgreSQL SSL key.
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=  # If n8n should reject unauthorized SSL connections (true) or not (false).
DB_SQLITE_POOL_SIZE=  # Controls whether to open the SQLite file in WAL mode or rollback journal mode. Uses rollback journal mode when set to zero. When greater than zero, uses WAL mode with the value determining the number of parallel SQL read connections to configure. WAL mode is much more performant and reliable than the rollback journal mode.
DB_SQLITE_VACUUM_ON_STARTUP=  # Runs VACUUM operation on startup to rebuild the database. Reduces file size and optimizes indexes. This is a long running blocking operation and increases start-up time.

# =================================
#            CLOUDFLARE
# =================================
CLOUDFLARE_TOKEN=
