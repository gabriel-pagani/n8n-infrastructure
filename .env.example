# =================================
#               N8N
# =================================
# Ask n8n AI
N8N_AI_ASSISTANT_BASE_URL=  # Base URL of the AI assistant service, specified as https://ai-assistant.n8n.io . Required if you self-host n8n and want to enable Ask n8n AI.

# Binary data
N8N_AVAILABLE_BINARY_DATA_MODES=  # A comma separated list of available binary data modes.
N8N_BINARY_DATA_DATABASE_MAX_FILE_SIZE=  # Maximum size (in MiB) of a single file n8n stores when N8N_DEFAULT_BINARY_DATA_MODE is database. Can't exceed 1024, the limit of a database column. Storing a larger file fails.
N8N_BINARY_DATA_STORAGE_PATH=  # The path where n8n stores binary data.
N8N_DEFAULT_BINARY_DATA_MODE=  # The default binary data mode. default keeps binary data in memory. Set to filesystem to use the filesystem, s3 to use AWS S3, azure to use Azure Blob Storage, or database to use the DB. Note that binary data pruning operates on the active binary data mode. For example, if your instance stored data in S3, and you later switched to filesystem mode, n8n only prunes binary data in the filesystem. This may change in future.

# Credentials
CREDENTIALS_OVERWRITE_DATA=  # Overwrites for credentials.
CREDENTIALS_OVERWRITE_ENDPOINT=  # The API endpoint to fetch credentials.
CREDENTIALS_OVERWRITE_PERSISTENCE=  # Enable database persistence for credential overwrites. Required for multi-instance or queue mode to propagate overwrites to workers through a publish/subscribe approach.
CREDENTIALS_DEFAULT_NAME=  # The default name for credentials.

