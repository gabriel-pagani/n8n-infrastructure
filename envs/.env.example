# =================================
#            POSTGRES
# =================================
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# =================================
#               N8N
# =================================
# Ask n8n AI
N8N_AI_ASSISTANT_BASE_URL=  # | String | (vazio) | URL base do serviço de assistente de IA, especificada como `https://ai-assistant.n8n.io`. Obrigatória se você hospeda o n8n por conta própria e quer habilitar o Ask n8n AI. |

# Dados binários
N8N_AVAILABLE_BINARY_DATA_MODES=  # | String | `filesystem` | Lista separada por vírgulas dos modos de dados binários disponíveis. |
N8N_BINARY_DATA_DATABASE_MAX_FILE_SIZE=  # | Number | `512` | Tamanho máximo (em MiB) de um único arquivo que o n8n armazena quando `N8N_DEFAULT_BINARY_DATA_MODE` é `database`. Não pode exceder `1024`, o limite de uma coluna do banco de dados. Armazenar um arquivo maior falha. |
N8N_BINARY_DATA_STORAGE_PATH=  # | String | `N8N_USER_FOLDER/binaryData` | Caminho onde o n8n armazena dados binários. |
N8N_DEFAULT_BINARY_DATA_MODE=  # | String | `default` | Modo padrão de dados binários. `default` mantém os dados binários em memória. Defina como `filesystem` para usar o sistema de arquivos, `s3` para usar o AWS S3, `azure` para usar o Azure Blob Storage ou `database` para usar o banco de dados. Observe que a limpeza (pruning) de dados binários opera sobre o modo de dados binários ativo. Por exemplo, se sua instância armazenava dados no S3 e depois você mudou para o modo filesystem, o n8n limpa apenas os dados binários no sistema de arquivos. Isso pode mudar no futuro. |

# Credenciais
CREDENTIALS_OVERWRITE_DATA=  # | * | - | Sobrescritas (overwrites) para credenciais. |
CREDENTIALS_OVERWRITE_ENDPOINT=  # | String | - | Endpoint da API para buscar credenciais. |
CREDENTIALS_OVERWRITE_PERSISTENCE=  # | Boolean | `false` | Habilita a persistência no banco de dados para sobrescritas de credenciais. Necessário para multi-instância ou modo fila propagarem as sobrescritas aos workers por meio de uma abordagem de publicação/assinatura. |
CREDENTIALS_DEFAULT_NAME=  # | String | `My credentials` | Nome padrão para credenciais. |

# Banco de dados
DB_TYPE=  # | Enum string:<br> `sqlite`, `postgresdb` | `sqlite` | Banco de dados a ser usado. |
DB_TABLE_PREFIX=  # | * | - | Prefixo a ser usado nos nomes das tabelas. |
DB_PING_INTERVAL_SECONDS=  # | Number | `2` | Com que frequência, em segundos, o n8n envia ping ao banco de dados para verificar se a conexão continua ativa. |
DB_PING_TIMEOUT_MS=  # | Number | `5000` | Quanto tempo, em milissegundos, o n8n espera a resposta de um único ping antes de contabilizá-lo como falha. Usa como alternativa o depreciado `N8N_DB_PING_TIMEOUT`, caso esteja definido. |
DB_PING_MAX_FAILURES_BEFORE_RECOVERY=  # | Number | `3` | Quantos pings consecutivos precisam falhar antes de o n8n considerar a conexão perdida e iniciar a recuperação. |
DB_RECOVERY_BACKOFF_MIN_MS=  # | Number | `1000` | Quanto tempo, em milissegundos, o n8n espera antes da primeira tentativa de recuperação. Cada nova tentativa espera mais tempo (backoff exponencial). |
DB_RECOVERY_BACKOFF_MAX_MS=  # | Number | `30000` | Tempo máximo, em milissegundos, que o n8n espera entre tentativas de recuperação. Isso limita o backoff. Deve ser maior ou igual a `DB_RECOVERY_BACKOFF_MIN_MS`. |
DB_CONNECTION_ACQUISITION_TIMEOUT_MS=  # | Number | `30000` | Quanto tempo, em milissegundos, uma consulta espera enquanto a recuperação está em andamento antes de falhar rapidamente com um erro. Defina como `0` para esperar indefinidamente. Aplica-se apenas ao PostgreSQL. |
DB_POSTGRESDB_DATABASE=  # | String | `n8n` | Nome do banco de dados PostgreSQL. |
DB_POSTGRESDB_HOST=  # | String | `localhost` | Host do PostgreSQL. |
DB_POSTGRESDB_PORT=  # | Number | `5432` | Porta do PostgreSQL. |
DB_POSTGRESDB_USER=  # | String | `postgres` | Usuário do PostgreSQL. |
DB_POSTGRESDB_PASSWORD=  # | String | - | Senha do PostgreSQL. |
DB_POSTGRESDB_POOL_SIZE=  # | Number | `2` | Controla quantas conexões Postgres abertas em paralelo o n8n deve ter. Aumentar o valor pode ajudar na utilização de recursos, mas conexões demais podem degradar o desempenho. |
DB_POSTGRESDB_CONNECTION_TIMEOUT=  # | Number | `20000` | Tempo limite de conexão do Postgres (ms).
DB_POSTGRESDB_IDLE_CONNECTION_TIMEOUT=  # | Number | `30000` | Tempo antes de uma conexão ociosa se tornar elegível para remoção por inatividade.
DB_POSTGRESDB_MAX_CONNECTION_LIFETIME_MS=  # | Number | `3600000` | Quanto tempo, em milissegundos, o n8n mantém uma conexão do pool antes de reciclá-la. Reciclar conexões antigas ajuda a evitar conexões obsoletas que o banco de dados ou a rede derrubaram sem que o n8n percebesse. O padrão é uma hora. Defina como `0` para desabilitar a reciclagem. |
DB_POSTGRESDB_KEEP_ALIVE=  # | Boolean | `true` | Se deve habilitar o TCP keep-alive nas conexões. O keep-alive permite que o n8n perceba uma conexão morta sem precisar executar uma consulta antes. |
DB_POSTGRESDB_KEEP_ALIVE_INITIAL_DELAY_MS=  # | Number | `10000` | Quanto tempo, em milissegundos, o n8n espera antes de enviar a primeira sonda TCP keep-alive em uma conexão. |
DB_POSTGRESDB_SCHEMA=  # | String | `public` | Schema do PostgreSQL. |
DB_POSTGRESDB_SSL_ENABLED=  # | Boolean | `false` | Se deve habilitar SSL. Habilitado automaticamente se `DB_POSTGRESDB_SSL_CA`, `DB_POSTGRESDB_SSL_CERT` ou `DB_POSTGRESDB_SSL_KEY` estiver definido com um valor não vazio, ou se `DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED` estiver definido como `false`. |
DB_POSTGRESDB_SSL_CA=  # | String | - | Autoridade certificadora SSL do PostgreSQL. |
DB_POSTGRESDB_SSL_CERT=  # | String | - | Certificado SSL do PostgreSQL. |
DB_POSTGRESDB_SSL_KEY=  # | String | - | Chave SSL do PostgreSQL. |
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=  # | Boolean | `true` | Se o n8n deve rejeitar conexões SSL não autorizadas (true) ou não (false). |
DB_SQLITE_POOL_SIZE=  # | Number | `0` | Controla se o arquivo SQLite é aberto em [modo WAL](https://www.sqlite.org/wal.html) ou [modo rollback journal](https://www.sqlite.org/lockingv3.html#rollback). Usa o modo rollback journal quando definido como zero. Quando maior que zero, usa o modo WAL, com o valor determinando o número de conexões SQL de leitura em paralelo a configurar. O modo WAL é muito mais performático e confiável que o modo rollback journal. |
DB_SQLITE_VACUUM_ON_STARTUP=  # | Boolean | `false` | Executa a operação [VACUUM](https://www.sqlite.org/lang_vacuum.html) na inicialização para reconstruir o banco de dados. Reduz o tamanho do arquivo e otimiza os índices. Essa é uma operação bloqueante e demorada, e aumenta o tempo de inicialização. |

# Implantação (deployment)
HTTP_PROXY=  # | String | - | URL para fazer proxy de requisições HTTP não criptografadas. Quando definida, o n8n encaminha todo o tráfego HTTP não criptografado dos nós através da URL do proxy. |
HTTPS_PROXY=  # | String | - | URL para fazer proxy de requisições HTTP criptografadas com TLS/SSL. Quando definida, o n8n encaminha todo o tráfego HTTP criptografado com TLS/SSL dos nós através da URL do proxy. |
ALL_PROXY=  # | String | - | URL para fazer proxy tanto de requisições HTTP criptografadas quanto não criptografadas. Quando definida, o n8n usa esse valor quando variáveis mais específicas (`HTTP_PROXY` ou `HTTPS_PROXY`) não estão presentes. |
NO_PROXY=  # | String | - | Lista separada por vírgulas de nomes de host ou URLs que devem ignorar o proxy. Ao usar `HTTP_PROXY`, `HTTPS_PROXY` ou `ALL_PROXY`, o n8n se conectará diretamente às URLs ou nomes de host definidos aqui em vez de usar o proxy. |
N8N_ENFORCE_GLOBAL_USER_AGENT=  # | Boolean | `false` | Quando definido como `true`, o n8n substitui a string User-Agent padrão simples `n8n` por um valor compatível com a RFC (`Mozilla/5.0 (compatible; n8n/<version>; +https://n8n.io/)`) em todas as requisições HTTP de saída. Habilite isso para evitar que firewalls de aplicação web bloqueiem as requisições do n8n. |
N8N_GLOBAL_USER_AGENT_VALUE=  # | String | - | String User-Agent personalizada para usar em todas as requisições HTTP de saída. Sobrepõe o padrão compatível com a RFC definido por `N8N_ENFORCE_GLOBAL_USER_AGENT`. Útil quando você não quer revelar a versão do n8n a servidores upstream. |
N8N_EDITOR_BASE_URL=  # | String | - | URL pública onde os usuários podem acessar o editor. Também usada para e-mails enviados pelo n8n e como URL de redirecionamento para autenticação baseada em SAML. |
N8N_DISABLE_UI=  # | Boolean | `false` | Defina como `true` para desabilitar a interface (UI). |
N8N_PREVIEW_MODE=  # | Boolean | `false` | Defina como `true` para executar em modo de pré-visualização. |
N8N_TEMPLATES_ENABLED=  # | Boolean | `true` | Habilita [templates de workflow](#user-content-fn-1)[^1] (true) ou desabilita (false). |
N8N_TEMPLATES_HOST=  # | String | `https://api.n8n.io` | Altere isso se estiver criando sua própria biblioteca de templates de workflow. Observe que, para usar sua própria biblioteca de templates de workflow, sua API deve fornecer os mesmos endpoints e a mesma estrutura de resposta da API do n8n. Consulte [Workflow templates](https://app.gitbook.com/s/rPN1zU5jaYNvwH7RzxqA/ways-of-building-workflows/use-templates) para mais informações. |
N8N_ENCRYPTION_KEY=  # | String | Chave aleatória gerada pelo n8n | Forneça uma chave personalizada usada para criptografar credenciais no banco de dados do n8n. Por padrão, o n8n gera uma chave aleatória na primeira inicialização. |
N8N_ENV_FEAT_ENCRYPTION_KEY_ROTATION=  # | Boolean | `false` | Defina como `true` em todas as instâncias (main e workers) para habilitar a [rotação da chave de criptografia](../../security/rotate-encryption-keys.md). Mudança irreversível: faça um backup completo do banco de dados antes. |
N8N_ENV_FEAT_OAUTH2_JWE=  # | Boolean | `false` | Defina como `true` em todas as instâncias (main e workers) para habilitar a [descriptografia de tokens JWE para credenciais OAuth 2.0](../../security/decrypt-oauth-20-tokens-with-jwe.md). Recurso em preview. |
N8N_ENV_FEAT_TOKEN_EXCHANGE=  # | Boolean | `false` | Defina como `true` para habilitar a [troca de tokens (token exchange) para parceiros de embedding](../../../deploy-as-an-oem-integration/set-up-token-exchange.md). Recurso em preview. |
N8N_OAUTH_JWE_JWKS_PER_MINUTE=  # | Number | `60` | Limite de taxa por IP no endpoint público JWKS (`/rest/.well-known/jwks.json`) usado pela [descriptografia de tokens JWE para credenciais OAuth 2.0](../../security/decrypt-oauth-20-tokens-with-jwe.md). |
N8N_MCP_BASE_URL=  # | String | - | URL base pública onde os clientes MCP alcançam o servidor MCP no nível da instância, quando ela difere da URL base da instância. Útil para implantações que servem o servidor MCP em um hostname dedicado (por exemplo, `https://n8n-mcp.example.com` na frente da mesma instância). Quando definida, o n8n anuncia o servidor MCP nessa URL e a aceita durante a autenticação OAuth, junto com a URL derivada da URL base da instância. Não afeta as URLs do editor nem de webhooks. Disponível a partir do n8n 2.31.0. |
N8N_MCP_SERVER_RATE_LIMIT=  # | Number | `100` | Número máximo de requisições por IP, a cada 5 minutos, ao endpoint do servidor MCP (`/mcp-server/http`). |
N8N_OAUTH_SERVER_REGISTER_RATE_LIMIT=  # | Number | `10` | Número máximo de requisições por IP, a cada 5 minutos, ao endpoint de registro de clientes do servidor OAuth (`/oauth/register` e `/mcp-oauth/register`). |
N8N_OAUTH_SERVER_AUTHORIZE_RATE_LIMIT=  # | Number | `50` | Número máximo de requisições por IP, a cada 5 minutos, ao endpoint de autorização do servidor OAuth (`/oauth/authorize` e `/mcp-oauth/authorize`). |
N8N_OAUTH_SERVER_TOKEN_RATE_LIMIT=  # | Number | `20` | Número máximo de requisições por IP, a cada 5 minutos, ao endpoint de token do servidor OAuth (`/oauth/token` e `/mcp-oauth/token`). |
N8N_OAUTH_SERVER_REVOKE_RATE_LIMIT=  # | Number | `30` | Número máximo de requisições por IP, a cada 5 minutos, ao endpoint de revogação de token do servidor OAuth (`/oauth/revoke` e `/mcp-oauth/revoke`). |
N8N_USER_FOLDER=  # | String | `user-folder` | Forneça o caminho onde o n8n criará a pasta `.n8n`. Esse diretório armazena dados específicos do usuário, como o arquivo do banco de dados e a chave de criptografia. |
N8N_PATH=  # | String | `/` | Caminho no qual o n8n é implantado. Combinar `N8N_PATH` com proxies reversos pode causar problemas de navegação entre pastas. Use um subdomínio (por exemplo, `n8n.example.com`) ou use `N8N_PATH` sem proxy reverso. |
N8N_HOST=  # | String | `localhost` | Nome do host em que o n8n é executado. |
N8N_PORT=  # | Number | `5678` | Porta HTTP em que o n8n é executado. |
N8N_LISTEN_ADDRESS=  # | String | `::` | Endereço IP no qual o n8n deve escutar. |
N8N_PROTOCOL=  # | Enum string: `http`, `https` | `http` | Protocolo usado para alcançar o n8n. |
N8N_SSL_KEY=  # | String | - | Chave SSL para o protocolo HTTPS. |
N8N_SSL_CERT=  # | String | - | Certificado SSL para o protocolo HTTPS. |
N8N_PERSONALIZATION_ENABLED=  # | Boolean | `true` | Se deve fazer perguntas de personalização aos usuários e então customizar o n8n de acordo. |
N8N_VERSION_NOTIFICATIONS_ENABLED=  # | Boolean | `true` | Quando habilitado, o n8n envia notificações de novas versões e atualizações de segurança. |
N8N_VERSION_NOTIFICATIONS_ENDPOINT=  # | String | `https://api.n8n.io/versions/` | Endpoint de onde recuperar as informações de versão. |
N8N_VERSION_NOTIFICATIONS_INFO_URL=  # | String | `https://docs.n8n.io/getting-started/installation/updating.html` | URL exibida no painel de Novas Versões para mais informações. |
N8N_DIAGNOSTICS_ENABLED=  # | Boolean | `true` | Se deve compartilhar [telemetria](https://app.gitbook.com/s/ukPPOMQ6NId4gpAIkPXa/) selecionada e anônima com o n8n. Observe que, se você definir isso como `false`, não poderá habilitar o Ask AI no nó Code. |
N8N_DIAGNOSTICS_CONFIG_FRONTEND=  # | String | `1zPn9bgWPzlQc0p8Gj1uiK6DOTn;https://telemetry.n8n.io` | Configuração de telemetria para o frontend. |
N8N_DIAGNOSTICS_CONFIG_BACKEND=  # | String | `1zPn7YoGC3ZXE9zLeTKLuQCB4F6;https://telemetry.n8n.io/v1/batch` | Configuração de telemetria para o backend. |
N8N_PUSH_BACKEND=  # | String | `websocket` | Escolha se o backend do n8n usa server-sent events (`sse`) ou WebSockets (`websocket`) para enviar alterações à interface. |
VUE_APP_URL_BASE_API=  # | String | `http://localhost:5678/` | Usada ao compilar manualmente o pacote `n8n-editor-ui` para definir como o frontend pode alcançar a API do backend. Consulte [Configure the Base URL](../configuration-examples/configure-the-base-url.md). |
N8N_HIRING_BANNER_ENABLED=  # | Boolean | `true` | Se deve exibir o banner de contratação do n8n no console (true) ou não (false). |
N8N_PUBLIC_API_SWAGGERUI_DISABLED=  # | Boolean | `false` | Se a Swagger UI (playground da API) está desabilitada (true) ou não (false). |
N8N_PUBLIC_API_DISABLED=  # | Boolean | `false` | Se deve desabilitar a API pública (true) ou não (false). |
N8N_PUBLIC_API_ENDPOINT=  # | String | `api` | Caminho para os endpoints da API pública. |
N8N_GRACEFUL_SHUTDOWN_TIMEOUT=  # | Number | `30` | Quanto tempo o processo do n8n deve esperar (em segundos) pelo encerramento dos componentes antes de finalizar o processo. |
N8N_DEV_RELOAD=  # | Boolean | `false` | Ao trabalhar no código-fonte do n8n, defina como `true` para recarregar ou reiniciar automaticamente a aplicação quando ocorrerem alterações nos arquivos de código-fonte. |
N8N_REINSTALL_MISSING_PACKAGES=  # | Boolean | `false` | Se definido como `true`, o n8n tentará reinstalar automaticamente quaisquer pacotes ausentes. |
N8N_TUNNEL_SUBDOMAIN=  # | String | - | Especifica o subdomínio para o túnel do n8n. Se não for definido, o n8n gera um subdomínio aleatório. |
N8N_PROXY_HOPS=  # | Number | 0 | Número de proxies reversos atrás dos quais o n8n está sendo executado. |

# Endpoints
N8N_PAYLOAD_SIZE_MAX=  # | Number | `16` | Tamanho máximo do payload em MiB. O padrão é 16 MiB, mas isso pode ser aumentado ajustando a variável para um valor maior. A instância do n8n precisa ser reiniciada para aplicar a nova configuração. Observação: aumentar o tamanho do payload exige mais recursos de memória e CPU e pode impactar o desempenho. Garanta que sua infraestrutura consegue lidar com payloads maiores. |
N8N_FORMDATA_FILE_SIZE_MAX=  # | Number | `200` | Tamanho máximo de payload para arquivos em payloads de webhook do tipo form-data, em MiB. |
N8N_METRICS=  # | Boolean | `false` | Se deve habilitar o endpoint `/metrics`. |
N8N_METRICS_PREFIX=  # | String | `n8n_` | Prefixo opcional para nomes de métricas específicas do n8n. |
N8N_METRICS_INCLUDE_DEFAULT_METRICS=  # | Boolean | `true` | Se deve expor as métricas padrão do sistema e do Node.js. |
N8N_METRICS_INCLUDE_CACHE_METRICS=  # | Boolean | false | Se deve incluir métricas (true) de acertos e erros de cache, ou não incluí-las (false). |
N8N_METRICS_INCLUDE_MESSAGE_EVENT_BUS_METRICS=  # | Boolean | `false` | Se deve incluir métricas (true) de eventos, ou não incluí-las (false). |
N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL=  # | Boolean | `false` | Se deve incluir um rótulo com o ID do workflow nas métricas de workflow. |
N8N_METRICS_INCLUDE_NODE_TYPE_LABEL=  # | Boolean | `false` | Se deve incluir um rótulo com o tipo do nó nas métricas de nós. |
N8N_METRICS_INCLUDE_CREDENTIAL_TYPE_LABEL=  # | Boolean | `false` | Se deve incluir um rótulo com o tipo da credencial nas métricas de credenciais. |
N8N_METRICS_INCLUDE_API_ENDPOINTS=  # | Boolean | `false` | Se deve expor métricas para endpoints da API. |
N8N_METRICS_INCLUDE_API_PATH_LABEL=  # | Boolean | `false` | Se deve incluir um rótulo com o caminho das chamadas de API. |
N8N_METRICS_INCLUDE_API_METHOD_LABEL=  # | Boolean | `false` | Se deve incluir um rótulo com o método HTTP (GET, POST, ...) das chamadas de API. |
N8N_METRICS_INCLUDE_API_STATUS_CODE_LABEL=  # | Boolean | `false` | Se deve incluir um rótulo com o código de status HTTP (200, 404, ...) das chamadas de API. |
N8N_METRICS_INCLUDE_QUEUE_METRICS=  # | Boolean | `false` | Se deve incluir métricas de jobs no modo de escalonamento (scaling mode). |
N8N_METRICS_QUEUE_METRICS_INTERVAL=  # | Integer | `20` | Com que frequência (em segundos) atualizar as métricas de fila. |
N8N_METRICS_INCLUDE_SSRF_METRICS=  # | Boolean | `false` | Se deve incluir métricas das verificações de proteção contra SSRF. |
N8N_METRICS_INCLUDE_DNS_CACHE_METRICS=  # | Boolean | `false` | Se deve incluir métricas do cache DNS (atualmente usado apenas pela proteção contra SSRF). |
N8N_ENDPOINT_REST=  # | String | `rest` | Caminho usado para o endpoint REST. |
N8N_ENDPOINT_WEBHOOK=  # | String | `webhook` | Caminho usado para o endpoint de webhook. |
N8N_ENDPOINT_WEBHOOK_TEST=  # | String | `webhook-test` | Caminho usado para o endpoint de webhook de teste. |
N8N_ENDPOINT_WEBHOOK_WAIT=  # | String | `webhook-waiting` | Caminho usado para o endpoint de webhook em espera. |
N8N_ENDPOINT_HEALTH=  # | String | `healthz` | Caminho usado para o endpoint de verificação de saúde (health check). |
N8N_WEBHOOK_URL=  # | String | - | Define a URL base tanto para webhooks de teste quanto de produção ao executar o n8n atrás de um proxy reverso. Use isso em vez das variáveis `N8N_ENDPOINT_*` acima, que definem apenas o _caminho_ do endpoint, não uma URL. Veja [Configure webhook URLs with reverse proxy](../configuration-examples/configure-webhook-urls-with-reverse-proxy.md). |
WEBHOOK_URL=  # | String | - | Alias depreciado de `N8N_WEBHOOK_URL`. Ainda funciona, mas o n8n registra um aviso de depreciação na inicialização. |
N8N_DISABLE_PRODUCTION_MAIN_PROCESS=  # | Boolean | `false` | Desabilita webhooks de produção no processo principal. Isso ajuda a garantir que não haja carga de tráfego HTTP no processo principal ao usar processos específicos para webhooks. |

# Execuções
EXECUTIONS_MODE=  # | Enum string: `regular`, `queue` | `regular` | Se as execuções devem rodar diretamente ou usando fila.<br><br>Consulte [Queue mode](../../scaling/enable-queue-mode.md) para mais detalhes. |
EXECUTIONS_TIMEOUT=  # | Number | `-1` | Define um tempo limite padrão (em segundos) para todos os workflows, após o qual o n8n interrompe sua execução. Os usuários podem sobrepor isso em workflows individuais, até a duração definida em `EXECUTIONS_TIMEOUT_MAX`. Defina `EXECUTIONS_TIMEOUT` como `-1` para desabilitar. |
EXECUTIONS_TIMEOUT_MAX=  # | Number | `3600` | Tempo máximo de execução (em segundos) que os usuários podem definir para um workflow individual. |
N8N_AI_TIMEOUT_MAX=  # | Number | `3600000` | Define o tempo limite de requisição HTTP, em milissegundos, para nós de IA e LLM (como OpenAI, Anthropic, Mistral e Ollama). Isso controla quanto tempo o n8n espera pelas respostas dos serviços de IA antes de expirar. Útil para serviços de IA locais mais lentos ou prompts complexos que exigem mais tempo de processamento. |
EXECUTIONS_DATA_SAVE_ON_ERROR=  # | Enum string: `all`, `none` | `all` | Se o n8n salva os dados de execução em caso de erro. |
EXECUTIONS_DATA_SAVE_ON_SUCCESS=  # | Enum string: `all`, `none` | `all` | Se o n8n salva os dados de execução em caso de sucesso. |
EXECUTIONS_DATA_SAVE_ON_PROGRESS=  # | Boolean | `false` | Se deve salvar o progresso de cada nó executado (true) ou não (false). |
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=  # | Boolean | `true` | Se deve salvar os dados de execuções iniciadas manualmente. |
N8N_EXECUTION_DATA_STORAGE_MODE=  # | Enum string: `database`, `filesystem`, `s3`, `azure` | `database` | Onde o n8n armazena os dados de execução. Os modos `s3` e `azure` exigem uma licença Enterprise. Consulte [External data storage](external-data-storage.md) para as variáveis de armazenamento relacionadas. |
N8N_STORAGE_PATH=  # | String | `N8N_USER_FOLDER/storage` | Caminho base para o armazenamento em sistema de arquivos. Quando `N8N_EXECUTION_DATA_STORAGE_MODE` é `filesystem`, o n8n armazena os dados de execução aqui. O n8n também usa esse caminho para dados binários em sistema de arquivos. |
EXECUTIONS_DATA_PRUNE=  # | Boolean | `true` | Se deve excluir os dados de execuções passadas de forma contínua (rolling basis). |
EXECUTIONS_DATA_MAX_AGE=  # | Number | `336` | Idade da execução (em horas) antes de ser excluída. |
EXECUTIONS_DATA_PRUNE_MAX_COUNT=  # | Number | `10000` | Número máximo de execuções a manter no banco de dados. 0 = sem limite |
EXECUTIONS_DATA_HARD_DELETE_BUFFER=  # | Number | `1` | Qual idade (em horas) os dados de execução finalizada precisam ter para sofrerem exclusão definitiva (hard delete). Por padrão, esse buffer exclui execuções recentes, já que o usuário pode precisar delas enquanto constrói um workflow. |
EXECUTIONS_DATA_PRUNE_HARD_DELETE_INTERVAL=  # | Number | `15` | Com que frequência (em minutos) os dados de execução devem sofrer exclusão definitiva (hard delete). |
EXECUTIONS_DATA_PRUNE_SOFT_DELETE_INTERVAL=  # | Number | `60` | Com que frequência (em minutos) os dados de execução devem sofrer exclusão lógica (soft delete). |
EXECUTIONS_DATA_MAX_DISPLAY_SIZE=  # | Number | `104857600` | Tamanho máximo (em bytes) dos dados de execução que o n8n carrega ao exibir uma execução (editor, detalhe da execução e API pública). Para execuções maiores, o n8n omite os dados (exibidos como "too large to display") para evitar que instâncias com poucos recursos fiquem sem memória. Não afeta a repetição (retry) nem a retomada de execuções, que sempre carregam os dados completos. Defina como `0` para desabilitar o limite. |
N8N_CONCURRENCY_PRODUCTION_LIMIT=  # | Number | `-1` | Número máximo de execuções de produção que podem rodar simultaneamente, tanto no modo regular quanto no modo de escalonamento. `-1` para desabilitar no modo regular. |
N8N_CONCURRENCY_EVALUATION_LIMIT=  # | Number | Padrão conforme o nível da licença | Número máximo de casos de teste que podem rodar em paralelo dentro de uma única execução de teste de [avaliação (evaluation)](https://app.gitbook.com/s/rPN1zU5jaYNvwH7RzxqA/integrate-ai/test-and-improve-ai-workflows/use-metrics-to-measure-quality#run-test-cases-in-parallel). Quando não definido, o limite segue o nível da licença (Community/Pro: 1, Business: 3, Enterprise: 5). Definir esse valor sobrepõe o padrão do nível. |
N8N_WORKFLOW_AUTODEACTIVATION_ENABLED=  # | Boolean | `false` | Se os workflows são automaticamente despublicados após execuções travadas (crashed) repetidas. |
N8N_WORKFLOW_AUTODEACTIVATION_MAX_LAST_EXECUTIONS=  # | Number | `3` | Número de execuções travadas antes de despublicar um workflow. |

# Motor de expressões
N8N_EXPRESSION_ENGINE=  # | Enum string: `legacy`, `vm` | `legacy` | Qual motor de expressões usar. `legacy` executa expressões sem isolamento. `vm` as executa em um isolate V8 em sandbox. `vm` é experimental; `legacy` continua sendo o padrão. |
N8N_EXPRESSION_ENGINE_POOL_SIZE=  # | Number | `1` | Número de isolates V8 mantidos aquecidos no pool. |
N8N_EXPRESSION_ENGINE_MAX_CODE_CACHE_SIZE=  # | Number | `1024` | Número máximo de expressões compiladas a manter em cache. |
N8N_EXPRESSION_ENGINE_TIMEOUT=  # | Number | `5000` | Tempo limite de execução, em milissegundos, para cada avaliação de expressão. |
N8N_EXPRESSION_ENGINE_MEMORY_LIMIT=  # | Number | `128` | Limite de memória, em MiB, para cada isolate V8. |
N8N_EXPRESSION_ENGINE_IDLE_TIMEOUT=  # | Number | - | Se definido, reduz o pool de isolates a zero isolates aquecidos após essa quantidade de segundos sem atividade. |

# Armazenamento externo de dados
N8N_EXTERNAL_STORAGE_S3_HOST=  # | String | - | Host do bucket do n8n em armazenamento externo compatível com S3. Por exemplo, `s3.us-east-1.amazonaws.com` |
N8N_EXTERNAL_STORAGE_S3_BUCKET_NAME=  # | String | - | Nome do bucket do n8n em armazenamento externo compatível com S3. |
N8N_EXTERNAL_STORAGE_S3_BUCKET_REGION=  # | String | - | Região do bucket do n8n em armazenamento externo compatível com S3. Por exemplo, `us-east-1` |
N8N_EXTERNAL_STORAGE_S3_ACCESS_KEY=  # | String | - | Chave de acesso no armazenamento externo compatível com S3 |
N8N_EXTERNAL_STORAGE_S3_ACCESS_SECRET=  # | String | - | Segredo de acesso no armazenamento externo compatível com S3. |
N8N_EXTERNAL_STORAGE_S3_AUTH_AUTO_DETECT=  # | Boolean | - | Usa detecção automática de credenciais para autenticar chamadas S3 no armazenamento externo. Isso ignora a chave de acesso e o segredo de acesso e usa a [cadeia padrão de provedores de credenciais](https://docs.aws.amazon.com/sdk-for-javascript/v3/developer-guide/setting-credentials-node.html#credchain). |
N8N_EXTERNAL_STORAGE_AZURE_CONNECTION_STRING=  # | String | - | String de conexão para o Azure Blob Storage. Tem precedência sobre o nome e a chave da conta quando definida. |
N8N_EXTERNAL_STORAGE_AZURE_ACCOUNT_NAME=  # | String | - | Nome da conta de armazenamento. Use com uma chave de conta ou identidade gerenciada. |
N8N_EXTERNAL_STORAGE_AZURE_ACCOUNT_KEY=  # | String | - | Chave da conta de armazenamento. Use com o nome da conta. |
N8N_EXTERNAL_STORAGE_AZURE_CONTAINER_NAME=  # | String | - | Nome do container de blobs onde armazenar dados de execução e/ou dados binários. Obrigatório para o Azure Blob Storage. |
N8N_EXTERNAL_STORAGE_AZURE_ENDPOINT=  # | String | - | Endpoint de blob personalizado, por exemplo para Azurite ou nuvens soberanas. |
N8N_EXTERNAL_STORAGE_AZURE_AUTH_AUTO_DETECT=  # | Boolean | `false` | Autentica via `DefaultAzureCredential` (identidade gerenciada, ambiente ou Azure CLI) em vez de uma chave de conta. Ignora a chave da conta quando habilitado. |

# Hooks externos
EXTERNAL_HOOK_FILES=  # | String | - | Arquivos contendo hooks externos de backend. Forneça múltiplos arquivos separados pelo caractere definido em `EXTERNAL_HOOK_FILES_SEPARATOR`. |
EXTERNAL_HOOK_FILES_SEPARATOR=  # | String | `:` | Caractere separador para `EXTERNAL_HOOK_FILES`. Use `;` no Windows para evitar conflitos com caminhos com letra de unidade, como `C:\`. |
EXTERNAL_FRONTEND_HOOKS_URLS=  # | String | - | URLs de arquivos contendo hooks externos de frontend. Forneça múltiplas URLs como uma lista separada por dois-pontos ("`:`"). |

# Segredos externos
N8N_EXTERNAL_SECRETS_UPDATE_INTERVAL=  # | Number | `300` (5 minutos) | Com que frequência (em segundos) verificar atualizações de segredos. |

# Insights
N8N_DISABLED_MODULES=  # | String | - | Defina como `insights` para desabilitar o recurso e a coleta de métricas em uma instância. |
N8N_INSIGHTS_COMPACTION_BATCH_SIZE=  # | Number | 500 | Quantidade de dados brutos de insights a compactar em um único lote. |
N8N_INSIGHTS_COMPACTION_BATCH_DELAY_MILLISECONDS=  # | Number | 100 | Atraso em milissegundos entre lotes completos de compactação. Aumente esse valor para esperar mais tempo entre os lotes. Defina como `0` para pular o atraso. |
N8N_INSIGHTS_COMPACTION_DAILY_TO_WEEKLY_THRESHOLD_DAYS=  # | Number | 180 | Idade em dias após a qual o n8n compacta as linhas diárias de insights em semanais. |
N8N_INSIGHTS_COMPACTION_HOURLY_TO_DAILY_THRESHOLD_DAYS=  # | Number | 90 | Idade em dias após a qual o n8n compacta as linhas horárias de insights em diárias. |
N8N_INSIGHTS_COMPACTION_INTERVAL_MINUTES=  # | Number | 60 | Intervalo (em minutos) em que a compactação deve ser executada. Diminua esse valor para executar a compactação com mais frequência e reduzir o acúmulo de dados entre execuções. |
N8N_INSIGHTS_COMPACTION_MAX_BATCHES_PER_RUN=  # | Number | 1000 | Número máximo de lotes de compactação a processar em uma execução. Diminua esse valor para processar menos lotes por execução. Defina como `0` para desabilitar esse limite. |
N8N_INSIGHTS_COMPACTION_MAX_RUNTIME_SECONDS=  # | Number | 300 | Tempo máximo de execução, em segundos, para uma execução de compactação. Diminua esse valor para encerrar cada execução mais cedo. Defina como `0` para desabilitar esse limite. |
N8N_INSIGHTS_FLUSH_BATCH_SIZE=  # | Number | 1000 | Número máximo de dados de insights a manter no buffer antes de descarregar (flush). |
N8N_INSIGHTS_FLUSH_INTERVAL_SECONDS=  # | Number | 30 | Intervalo (em segundos) em que o n8n descarrega os dados de insights no banco de dados. |
N8N_INSIGHTS_MAX_AGE_DAYS=  # | Number | 365 | Número de dias que o n8n mantém os dados compactados de insights antes de removê-los. O valor máximo é 730 (dois anos). |
N8N_INSIGHTS_PRUNE_CHECK_INTERVAL_HOURS=  # | Number | 24 | Com que frequência (em horas) a instância verifica dados de insights mais antigos que a idade máxima efetiva e os exclui. |

# Licença
N8N_HIDE_USAGE_PAGE=  # | boolean | `false` | Oculta a página de uso e planos no aplicativo. |
N8N_LICENSE_ACTIVATION_KEY=  # | String | `''` | Chave de ativação para inicializar a licença. Não se aplica se a instância do n8n já foi ativada. |
N8N_LICENSE_AUTO_RENEW_ENABLED=  # | Boolean | `true` | <p>Habilita (true) ou desabilita (false) a renovação automática de licenças.<br>Se desabilitada, você precisa renovar a licença manualmente a cada 10 dias navegando até <strong>Settings</strong> > <strong>Usage and plan</strong> e pressionando <code>F5</code>. A falha em renovar a licença desabilitará todos os recursos licenciados.</p> |
N8N_LICENSE_DETACH_FLOATING_ON_SHUTDOWN=  # | Boolean | `true` | <p>Controla se a instância libera as <a href="https://app.gitbook.com/s/CxSeOtVxqqhfxMSac0AV/key-concept-glossary#entitlement-n8n">entitlements flutuantes</a> de volta ao pool no desligamento. Defina como <code>true</code> para permitir que outras instâncias reutilizem as entitlements, ou <code>false</code> para retê-las.<br>Para instâncias de produção que precisam manter sempre seus recursos licenciados, defina como <code>false</code>.</p> |
N8N_LICENSE_SERVER_URL=  # | String | `https://license.n8n.io/v1` | URL do servidor para obter a licença. |
N8N_LICENSE_TENANT_ID=  # | Number | `1` | ID do tenant associado à licença. Defina essa variável somente se explicitamente instruído pelo n8n. |
https_proxy_license_server=  # | String | `https://user:pass@proxy:port` | URL do servidor proxy para requisições HTTPS de obtenção da licença. Este nome de variável precisa estar em minúsculas.

# Logs
N8N_LOG_LEVEL=  # | Enum string: `info`, `warn`, `error`, `debug` | `info` | Nível de saída dos logs. Consulte [Log levels](../../../keep-n8n-running/set-up-logging.md#log-levels) para detalhes. |
N8N_LOG_OUTPUT=  # | Enum string: `console`, `file` | `console` | Onde emitir os logs. Forneça múltiplos valores como uma lista separada por vírgulas. |
N8N_LOG_FORMAT=  # | Enum string: `text`, `json` | `text` | Formato de log a ser usado. `text` imprime mensagens legíveis por humanos. `json` imprime um objeto JSON por linha contendo a mensagem, o nível, o timestamp e todos os metadados. Isso é útil tanto para monitoramento em produção quanto para depuração. |
N8N_LOG_CRON_ACTIVE_INTERVAL=  # | Number | `0` | Intervalo em minutos para registrar em log os cron jobs atualmente ativos. Defina como `0` para desabilitar. |
N8N_LOG_FILE_COUNT_MAX=  # | Number | `100` | Número máximo de arquivos de log a manter. |
N8N_LOG_FILE_SIZE_MAX=  # | Number | `16` | Tamanho máximo de cada arquivo de log em MB. |
N8N_LOG_FILE_LOCATION=  # | String | `<n8n-directory-path>/logs/n8n.log` | Localização do arquivo de log. Requer `N8N_LOG_OUTPUT` definido como `file`. |
DB_LOGGING_ENABLED=  # | Boolean | `false` | Se deve habilitar o log específico do banco de dados. |
DB_LOGGING_OPTIONS=  # | Enum string: `query`, `error`, `schema`, `warn`, `info`, `log` | `error` | Nível de saída dos logs do banco de dados. Para habilitar todos os logs, especifique `all`. Consulte [TypeORM logging options](https://orkhan.gitbook.io/typeorm/docs/docs/advanced-topics/5-logging#logging-options) |
DB_LOGGING_MAX_EXECUTION_TIME=  # | Number | `1000` | Tempo máximo de execução (em milissegundos) antes de o n8n registrar um aviso. Defina como `0` para desabilitar o aviso de consultas demoradas. |
CODE_ENABLE_STDOUT=  # | Boolean | `false` | Defina como `true` para enviar os logs do nó Code provenientes de `console.log` ou `print` para o stdout do processo, apenas em execuções de produção. |
NO_COLOR=  # | any | `undefined` | Defina com qualquer valor para emitir logs sem cores ANSI. Para mais informações, veja o [site no-color.org](https://no-color.org/). |
N8N_EVENTBUS_CHECKUNSENTINTERVAL=  # | Number | `0` | Com que frequência (em milissegundos) verificar mensagens de evento não enviadas. Em casos raros, pode enviar a mensagem duas vezes. Defina como `0` para desabilitar. |
N8N_EVENTBUS_LOGWRITER_SYNCFILEACCESS=  # | Boolean | `false` | Se todo acesso a arquivos ocorre de forma síncrona dentro da thread (true) ou não (false). |
N8N_EVENTBUS_LOGWRITER_KEEPLOGCOUNT=  # | Number | `3` | Número de arquivos de log de eventos a manter. |
N8N_EVENTBUS_LOGWRITER_MAXFILESIZEINKB=  # | Number | `10240` | Tamanho máximo (em kilobytes) de um arquivo de log de eventos antes de iniciar um novo. |
N8N_EVENTBUS_LOGWRITER_LOGBASENAME=  # | String | `n8nEventLog` | Nome base do arquivo de log de eventos. Ignorado quando `N8N_EVENTBUS_LOGWRITER_LOGFULLPATH` está definido. |
N8N_EVENTBUS_LOGWRITER_LOGFULLPATH=  # | String | `''` | Caminho absoluto para o arquivo de log de eventos. Deve terminar em `.log`. Quando definido, esse caminho é usado literalmente e sobrepõe `N8N_EVENTBUS_LOGWRITER_LOGBASENAME` e o sufixo padrão por processo. Use isso para dar a cada processo do n8n um caminho único de log de eventos quando múltiplos processos compartilham um sistema de arquivos gravável. Consulte [Per-process event log files](https://app.gitbook.com/s/wMJrGrimpx3PxCJpUswm/observe-and-log/stream-logs-to-external-systems#per-process-event-log-files) para detalhes. |
N8N_EVENTBUS_LOGWRITER_MAXTOTALMESSAGESPERFILE=  # | Number | `500000` | Número máximo de linhas analisadas de um único arquivo de log de eventos durante a recuperação. Limita o uso de memória quando um arquivo de log de eventos contém muitas linhas inválidas. |
N8N_LOG_STREAMING_MANAGED_BY_ENV=  # | Boolean | `false` | Defina como `true` para gerenciar o streaming de logs a partir de variáveis de ambiente. Quando `true`, o n8n aplica as variáveis de streaming de logs a cada inicialização e bloqueia os controles correspondentes na interface. |
N8N_LOG_STREAMING_DESTINATIONS=  # | JSON string | - | Array JSON de destinos de streaming de logs. Cada destino é um objeto com um `type` igual a `webhook`, `syslog` ou `sentry`, mais a configuração daquele tipo. |

# Nós
N8N_COMMUNITY_PACKAGES_AUTH_TOKEN=  # | String | - | Token de autenticação para um registro npm privado. Use com `N8N_COMMUNITY_PACKAGES_REGISTRY` para autenticar requisições ao instalar nós da comunidade a partir de um registro privado. |
N8N_COMMUNITY_PACKAGES_ENABLED=  # | Boolean | `true` | Habilita (true) ou desabilita (false) a funcionalidade de instalar e carregar nós da comunidade. Se definido como false, nem pacotes de comunidade verificados nem não verificados estarão disponíveis, independentemente de suas configurações individuais. |
N8N_COMMUNITY_PACKAGES_PREVENT_LOADING=  # | Boolean | `false` | Impede (true) ou permite (false) o carregamento de nós da comunidade instalados na inicialização da instância. Use isso se um nó defeituoso impedir a instância de iniciar. |
N8N_COMMUNITY_PACKAGES_REGISTRY=  # | String | `https://registry.npmjs.org` | URL do registro NPM de onde obter pacotes da comunidade (requer licença). |
N8N_CUSTOM_EXTENSIONS=  # | String | - | Especifique o caminho para os diretórios que contêm seus nós personalizados. |
N8N_PYTHON_ENABLED=  # | Boolean | `true` | Se deve habilitar a execução de Python no nó Code. |
N8N_UNVERIFIED_PACKAGES_ENABLED=  # | Boolean | `true` | Quando `N8N_COMMUNITY_PACKAGES_ENABLED` é true, esta variável controla se deve habilitar a instalação e o uso de nós da comunidade não verificados a partir de um registro NPM (true) ou não (false). |
N8N_VERIFIED_PACKAGES_ENABLED=  # | Boolean | `true` | Quando `N8N_COMMUNITY_PACKAGES_ENABLED` é true, esta variável controla se deve exibir nós da comunidade verificados no painel de nós para instalação e uso (true) ou ocultá-los (false). |
NODE_FUNCTION_ALLOW_BUILTIN=  # | String | - | Permite que os usuários importem módulos nativos (built-in) específicos no nó Code. Use \* para permitir todos. O n8n desabilita a importação de módulos por padrão. |
NODE_FUNCTION_ALLOW_EXTERNAL=  # | String | - | Permite que os usuários importem módulos externos específicos (de `n8n/node_modules`) no nó Code. O n8n desabilita a importação de módulos por padrão. |
NODES_ERROR_TRIGGER_TYPE=  # | String | `n8n-nodes-base.errorTrigger` | Especifica qual tipo de nó usar como Error Trigger. |
NODES_EXCLUDE=  # | Array of strings | `[\"n8n-nodes-base.executeCommand\", \"n8n-nodes-base.localFileTrigger\"]` | Especifica quais nós não carregar. Por exemplo, para bloquear nós que podem ser um risco de segurança se os usuários não forem confiáveis: `NODES_EXCLUDE: "[\"n8n-nodes-base.executeCommand\", \"@n8n/n8n-nodes-langchain.lmChatDeepSeek\"]"`. Para habilitar todos os nós, especifique `NODES_EXCLUDE: "[]"`. |
NODES_INCLUDE=  # | Array of strings | - | Especifica quais nós carregar. |
NODES_MERGE_SQL_SANDBOX_MEMORY_LIMIT_MB=  # | Number | `64` | Limite de memória em MB para o sandbox SQL do nó Merge. Aumente esse valor se o "Combine by SQL" falhar com grandes conjuntos de dados e sua instância tiver memória suficiente disponível. |
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=  # | Number | `2147483648` | Tamanho total máximo de saída descompactada em bytes. O padrão é 2 GiB. |
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=  # | Number | `5000` | Número máximo de entradas permitidas em um arquivo ZIP. |
N8N_COMMUNITY_PACKAGES_MANAGED_BY_ENV=  # | Boolean | `false` | Defina como `true` para gerenciar os pacotes da comunidade instalados a partir de variáveis de ambiente. Quando `true`, o n8n reconcilia os pacotes instalados com `N8N_COMMUNITY_PACKAGES` a cada inicialização, instalando pacotes ausentes, corrigindo versões e **desinstalando quaisquer pacotes atualmente instalados que não estejam na lista**. A página de configurações **Community nodes** torna-se somente leitura: você não pode instalar, atualizar ou desinstalar pacotes pela interface enquanto isso estiver habilitado. |
N8N_COMMUNITY_PACKAGES=  # | JSON string | - | Array JSON de pacotes da comunidade a instalar. Cada entrada é um objeto com um `name` (obrigatório) e campos opcionais `version` e `checksum`. Você também pode embutir a versão no nome como `<package-name>@<version>`. Veja [environment variable installation](/integrations/community-nodes/installation-and-management/environment-variable-installation.md) para a referência completa de cada campo. |

# OpenTelemetry
N8N_OTEL_ENABLED=  # | Boolean | `false` | Se deve habilitar o tracing do OpenTelemetry. Quando definido como `false`, o n8n não carrega o SDK do OpenTelemetry. | 2.19.0 |
N8N_OTEL_EXPORTER_OTLP_ENDPOINT=  # | String | `http://localhost:4318` | URL base do endpoint OTLP HTTP para o qual exportar traces. O n8n anexa o valor de `N8N_OTEL_EXPORTER_OTLP_TRACING_PATH` a essa URL. | 2.19.0 |
N8N_OTEL_EXPORTER_OTLP_TRACING_PATH=  # | String | `/v1/traces` | Caminho anexado a `N8N_OTEL_EXPORTER_OTLP_ENDPOINT` para exportar traces. | 2.19.0 |
N8N_OTEL_EXPORTER_OTLP_HEADERS=  # | String | - | Lista separada por vírgulas de pares `key=value` a enviar como cabeçalhos HTTP em cada requisição OTLP. Use isso para tokens de autenticação ou cabeçalhos de tenant. Por exemplo: `authorization=Bearer <token>,x-tenant=acme`. | 2.19.0 |
N8N_OTEL_EXPORTER_SERVICE_NAME=  # | String | `n8n` | Valor do atributo de recurso `service.name` nos spans exportados. | 2.19.0 |
N8N_OTEL_TRACES_SAMPLE_RATE=  # | Number | `1.0` | Fração de traces a exportar, entre `0` e `1`. O n8n usa um sampler baseado na razão do trace ID, então todos os spans de um trace são amostrados ou descartados em conjunto. | 2.19.0 |
N8N_OTEL_TRACES_INCLUDE_NODE_SPANS=  # | Boolean | `true` | Se deve emitir um span `node.execute` para cada execução de nó. Defina como `false` para exportar apenas os spans em nível de workflow. | 2.19.0 |
N8N_OTEL_TRACES_PRODUCTION_ONLY=  # | Boolean | `true` | Se deve exportar traces apenas de [execuções de produção](/build/understand-workflows/understand-executions/types-of-executions.md). Defina como `false` para exportar traces de todas as execuções de workflow. | 2.25.2 |
N8N_OTEL_TRACES_INJECT_OUTBOUND=  # | Boolean | `true` | Se deve injetar os cabeçalhos W3C `traceparent`/`tracesstate` nas requisições HTTP de saída feitas por nós que usam os helpers HTTP do n8n. | 2.19.0 |
N8N_OTEL_STARTUP_CONNECTIVITY_TIMEOUT_MS=  # | Number | `2000` | Tempo limite (em milissegundos) para a verificação de conectividade na inicialização contra o endpoint OTLP. O n8n registra um aviso se o endpoint não estiver acessível dentro desse período. | 2.19.0 |
N8N_AGENTS_TRACING_ENABLED=  # | Boolean | `true` | Se as execuções de agentes emitem spans do OpenTelemetry. Herda as configurações de endpoint, cabeçalhos, amostragem e transporte de `N8N_OTEL_*`. Os spans não têm para onde ir até que você configure um provedor OTel, então defina como `false` para executar o tracing de workflows sem os spans de agentes. | 2.33.0 |
N8N_AGENTS_TRACING_RECORD_INPUTS=  # | Boolean | `true` | Se o tracing de agentes registra entradas, como prompts e argumentos de ferramentas. Defina como `false` para excluir dados de entrada sensíveis dos traces. | 2.33.0 |
N8N_AGENTS_TRACING_RECORD_OUTPUTS=  # | Boolean | `true` | Se o tracing de agentes registra saídas, como respostas e resultados de ferramentas. Defina como `false` para excluir dados de saída sensíveis dos traces. | 2.33.0 |

# Modo fila (queue mode)
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=  # | Boolean | `false` | Defina como `true` se quiser que as execuções manuais rodem no worker em vez de na instância main. |
QUEUE_BULL_PREFIX=  # | String | - | Prefixo a ser usado em todas as chaves da fila. |
QUEUE_BULL_REDIS_DB=  # | Number | `0` | Banco de dados do Redis usado. |
QUEUE_BULL_REDIS_HOST=  # | String | `localhost` | Host do Redis. |
QUEUE_BULL_REDIS_PORT=  # | Number | `6379` | Porta do Redis usada. |
QUEUE_BULL_REDIS_USERNAME=  # | String | - | Usuário do Redis (requer Redis versão 6 ou superior). Não o defina para compatibilidade com Redis < 6 |
QUEUE_BULL_REDIS_PASSWORD=  # | String | - | Senha do Redis. |
QUEUE_BULL_REDIS_TIMEOUT_THRESHOLD=  # | Number | `10000` | Limite de tempo limite (timeout) do Redis, em ms. |
QUEUE_BULL_REDIS_CLUSTER_NODES=  # | String | - | Espera uma lista separada por vírgulas de nós do Redis Cluster no formato `host:port`, aos quais o cliente Redis se conectará inicialmente. Se estiver rodando em modo fila (`EXECUTIONS_MODE = queue`), definir essa variável criará um cliente Redis Cluster em vez de um cliente Redis, e o n8n ignorará `QUEUE_BULL_REDIS_HOST` e `QUEUE_BULL_REDIS_PORT`. |
QUEUE_BULL_REDIS_TLS=  # | Boolean | `false` | Habilita TLS nas conexões Redis. |
QUEUE_BULL_REDIS_DUALSTACK=  # | Boolean | `false` | Habilita suporte dual-stack (IPv4 e IPv6) nas conexões Redis. |
QUEUE_WORKER_TIMEOUT=  # (**depreciado**) | Number | `30` | **Depreciado** Use `N8N_GRACEFUL_SHUTDOWN_TIMEOUT` em vez disso. Quanto tempo o n8n deve esperar (em segundos) pelas execuções em andamento antes de encerrar o processo do worker no desligamento. |
QUEUE_HEALTH_CHECK_ACTIVE=  # | Boolean | `false` | Se deve habilitar as verificações de saúde (true) ou desabilitar (false). |
QUEUE_HEALTH_CHECK_PORT=  # | Number | `5678` | Porta na qual servir as verificações de saúde. Se você encontrar um erro de conflito de porta ao iniciar um servidor worker usando sua porta padrão, altere isso. |
QUEUE_WORKER_LOCK_DURATION=  # | Number | `60000` | Duração (em ms) do período de lease para um worker trabalhar em uma mensagem. |
QUEUE_WORKER_LOCK_RENEW_TIME=  # | Number | `10000` | Com que frequência (em ms) um worker deve renovar o tempo de lease. |
QUEUE_WORKER_STALLED_INTERVAL=  # | Number | `30000` | Com que frequência um worker deve verificar jobs travados (stalled) — use 0 para nunca. |
QUEUE_WORKER_MAX_STALLED_COUNT=  # | Number | `1` | Número máximo de vezes que um job travado será reprocessado. |
N8N_WEBHOOK_RESPONSE_RELAY_SIZE_MAX=  # | Number | `64` | Tamanho máximo (em MiB) de uma resposta que um worker envia de volta à instância main dentro de uma mensagem de fila. O Redis mantém várias cópias de uma resposta em trânsito, então reserve cerca de 1,5 vez esse valor de memória no Redis por resposta em trânsito. O mesmo limite se aplica ao resultado de uma ferramenta retornado por um workflow com MCP Trigger. |
N8N_WEBHOOK_RESPONSE_RELAY_OFFLOAD_ENABLED=  # | Boolean | `false` | Se um worker armazena um corpo de resposta acima de `N8N_WEBHOOK_RESPONSE_RELAY_SIZE_MAX` no armazenamento de dados binários, para que a instância main possa transmiti-lo (stream) ao cliente, em vez de falhar o nó. Requer um `N8N_DEFAULT_BINARY_DATA_MODE` que armazene (`filesystem`, `database`, `s3` ou `azure`) e um armazenamento que todas as instâncias possam ler. Defina isso nos seus workers apenas depois que todas as instâncias main e webhook estiverem rodando o n8n 2.34.0 ou posterior. |
N8N_MULTI_MAIN_SETUP_ENABLED=  # | Boolean | `false` | Se deve habilitar a configuração multi-main para o modo fila (requer licença). |
N8N_MULTI_MAIN_SETUP_KEY_TTL=  # | Number | `10` | Tempo de vida (em segundos) da chave de líder na configuração multi-main. |
N8N_MULTI_MAIN_SETUP_CHECK_INTERVAL=  # | Number | `3` | Intervalo (em segundos) para a verificação de líder na configuração multi-main. |

# Agendador (scheduler)
N8N_SCHEDULER_ENABLED=  # | Boolean | `false` | Se deve ativar o agendador durável. Quando ativado, o agendador armazena as execuções agendadas no banco de dados antes de elas rodarem, de modo que um reinício não as descarte e, entre múltiplas instâncias, cada execução ocorra apenas uma vez. Requer `N8N_USE_WORKFLOW_PUBLICATION_SERVICE` para assumir o controle dos nós Schedule Trigger. |
N8N_SCHEDULER_MATERIALIZATION_WINDOW=  # | Number | `60` | Quão longe no futuro, em segundos, o agendador registra as execuções futuras. Uma janela maior compromete mais execuções antecipadamente (mais resiliente a indisponibilidades, com um pouco mais de rotatividade de armazenamento). Deve ser maior que 0. |
N8N_SCHEDULER_MATERIALIZATION_INTERVAL=  # | Number | `10` | Com que frequência, em segundos, o agendador varre os agendamentos ativos para registrar as execuções que caem dentro da janela. Deve ser maior que 0. |
N8N_SCHEDULER_MATERIALIZATION_TIMEOUT=  # | Number | `60` | Por quanto tempo, em segundos, uma única varredura pode rodar antes de ser abandonada e repetida no próximo intervalo. Protege contra uma varredura travada em um banco de dados lento. Deve ser maior que 0. |
N8N_SCHEDULER_EXECUTOR_INTERVAL=  # | Number | `5` | Com que frequência, em segundos, o agendador verifica execuções registradas cujo horário chegou e as inicia. Define o atraso de pior caso entre o horário agendado de uma execução e seu início. Diminua para um tempo mais preciso, ao custo de polling mais frequente. Deve ser maior que 0. |
N8N_SCHEDULER_EXECUTOR_TIMEOUT=  # | Number | `60` | Por quanto tempo, em segundos, uma única verificação de execuções pendentes pode rodar antes de ser abandonada e repetida no próximo intervalo. Deve ser maior que 0. |
N8N_SCHEDULER_LEASE_DURATION=  # | Number | `60` | Por quanto tempo, em segundos, uma instância mantém uma reivindicação exclusiva sobre uma execução que assumiu, para que nenhuma outra instância inicie a mesma. Se a instância parar sem terminar, a reivindicação expira após esse tempo e outra instância pode assumir. Mantenha esse valor confortavelmente acima do tempo que uma execução precisa para começar: curto demais arrisca uma execução duplicada, longo demais atrasa a recuperação após uma falha. Deve ser maior que 0. |
N8N_SCHEDULER_CLAIM_BATCH_SIZE=  # | Number | `100` | Número máximo de execuções que uma única reivindicação retira da fila em uma passagem. Lotes maiores drenam um backlog mais rápido, mas concentram mais trabalho em uma instância por tick. Deve ser maior que 0. |
N8N_SCHEDULER_REAPER_INTERVAL=  # | Number | `30` | Com que frequência, em segundos, o agendador procura execuções que uma instância reivindicou mas nunca finalizou (por exemplo, após uma falha ou desligamento) e as disponibiliza novamente. Deve ser maior que 0. |
N8N_SCHEDULER_REAPER_BATCH_SIZE=  # | Number | `100` | Número máximo de execuções com reivindicação expirada que uma única passagem do reaper recupera. Lotes maiores recuperam um backlog mais rápido, mas concentram mais trabalho em uma instância por passagem. Deve ser maior que 0. |
N8N_SCHEDULER_REAPER_TIMEOUT=  # | Number | `60` | Por quanto tempo, em segundos, uma única passagem de recuperação pode rodar antes de ser abandonada e repetida no próximo intervalo. Deve ser maior que 0. |
N8N_SCHEDULER_MAX_ATTEMPTS=  # | Number | `5` | Quantas vezes uma execução agendada pode ser rereivindicada (por exemplo, após uma falha) ou repetida em caso de erro antes de o n8n desistir dela e enviá-la para a fila de mensagens mortas (dead-letter). Aumente esse valor em infraestruturas propensas a reinícios de instância ou erros transitórios; diminua para desistir e seguir em frente mais cedo. Deve ser maior que 0. |
N8N_SCHEDULER_RETENTION=  # | Number | `86400` | Por quanto tempo, em segundos, o agendador mantém as execuções que terminaram sem problemas (um sucesso ou um cancelamento) antes de excluí-las. O padrão é um dia. Aumente para manter mais histórico, diminua para recuperar espaço no banco de dados mais cedo. Deve ser maior que 0. |
N8N_SCHEDULER_FAILED_RETENTION=  # | Number | `604800` | Por quanto tempo, em segundos, o agendador mantém as execuções que deram errado (uma falha ou uma execução perdida) antes de excluí-las. O padrão é sete dias. Mantenha esse valor maior que `N8N_SCHEDULER_RETENTION` para haver tempo de depurar; o agendador emite um aviso se você o definir menor. Deve ser maior que 0. |
N8N_SCHEDULER_RETENTION_INTERVAL=  # | Number | `3600` | Com que frequência, em segundos, o agendador exclui execuções finalizadas mais antigas que as janelas de retenção. O padrão é uma hora. Deve ser maior que 0. |
N8N_SCHEDULER_RETENTION_TIMEOUT=  # | Number | `300` | Por quanto tempo, em segundos, uma única passagem de limpeza pode rodar antes de ser abandonada e repetida no próximo intervalo. O padrão é cinco minutos. Deve ser maior que 0. |
N8N_SCHEDULER_MAX_CONCURRENT_PASSES=  # | Number | `10` | Número máximo de passagens em segundo plano do mesmo tipo que podem rodar ao mesmo tempo em uma instância, quando o banco de dados suporta passagens sobrepostas (PostgreSQL). Se uma passagem vencer enquanto o limite já estiver em uso, o n8n a ignora. No SQLite, as passagens nunca se sobrepõem, então essa configuração não tem efeito. Deve ser maior que 0. |
N8N_SCHEDULER_JITTER_RATIO=  # | Number | `0.1` | Uma pequena variação aleatória adicionada ao tempo de cada passagem periódica, como fração do intervalo. Com `0.1`, uma passagem configurada para rodar a cada 10 segundos, na prática, roda a cada 9 a 11 segundos. Isso distribui as consultas ao banco de dados de instâncias iniciadas ao mesmo tempo, como durante um rolling deploy. Defina como `0` para intervalos exatos, ou aumente para distribuir a carga de forma mais uniforme. Deve ser no mínimo 0 e menor que 1. |
N8N_SCHEDULER_MIN_INTERVAL=  # | Number | `0` | O menor intervalo, em segundos, permitido entre execuções consecutivas do mesmo agendamento. O n8n reduz a velocidade de um agendamento configurado para rodar com mais frequência até esse intervalo. O padrão é `0`, que desabilita o limite e respeita qualquer intervalo especificado por cada agendamento. Defina-o para impedir que um agendamento descontrolado de cada segundo sobrecarregue a instância. |
N8N_SCHEDULER_TRIGGER_NODE_MODE=  # | Enum (`legacy`, `new`) | `legacy` | Como os agendamentos de "a cada N segundos" e "a cada N minutos" de um nó Schedule Trigger disparam. `legacy` mantém o tempo alinhado ao relógio, correspondendo ao agendador em memória; `new` espaça as execuções de forma constante em N a partir do horário de ativação. Afeta apenas intervalos de segundos e minutos. Veja [Schedule Trigger timing](/deploy/host-n8n/configure-n8n/durable-scheduler.md#trigger-node-mode). |

# Segurança
N8N_BLOCK_ENV_ACCESS_IN_NODE=  # | Boolean | `false` | Se deve permitir que os usuários acessem variáveis de ambiente em expressões e no nó Code (false) ou não (true). |
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=  # | Boolean | `true` | Defina como `true` para bloquear o acesso a todos os arquivos no diretório `.n8n` e aos arquivos de configuração definidos pelo usuário. |
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=  # | Boolean | `false` | Defina como `true` para tentar aplicar permissões 0600 ao arquivo de configurações, dando acesso de leitura e escrita somente ao proprietário. |
N8N_RESTRICT_FILE_ACCESS_TO=  # | String |  | Limita o acesso a arquivos nesses diretórios. Forneça múltiplos arquivos como uma lista separada por ponto e vírgula ("`;`"). |
N8N_SECURITY_AUDIT_DAYS_ABANDONED_WORKFLOW=  # | Number | 90 | Número de dias para considerar um workflow abandonado caso não seja executado. |
N8N_CONTENT_SECURITY_POLICY=  # | String | `{}` | Define os cabeçalhos [Content-Security-Policy](https://developer.mozilla.org/en-US/docs/Web/HTTP/CSP) como um objeto de diretivas aninhadas do [helmet.js](https://helmetjs.github.io/#content-security-policy). Por exemplo, `{ "frame-ancestors": ["http://localhost:3000"] }` |
N8N_SECURE_COOKIE=  # | Boolean | `true` | Garante que os cookies sejam enviados apenas por HTTPS, aumentando a segurança. |
N8N_SAMESITE_COOKIE=  # | Enum string: `strict`, `lax`, `none` | `lax` | <p>Controla o comportamento de cookies entre sites (<a href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Set-Cookie/SameSite">saiba mais</a>):</p><ul><li><code>strict</code>: Enviado apenas em requisições de primeira parte.</li><li><code>lax</code> (padrão): Enviado em requisições de navegação de nível superior.</li><li><code>none</code>: Enviado em todos os contextos (requer HTTPS).</li></ul> |
N8N_GIT_NODE_DISABLE_BARE_REPOS=  # | Boolean | `false` | Defina como `true` para impedir que o [nó Git](/integrations/builtin/core-nodes/n8n-nodes-base.git.md) trabalhe com repositórios bare, aumentando a segurança. |
N8N_GIT_NODE_ENABLE_HOOKS=  # | Boolean | `false` | Defina como `true` para permitir que o [nó Git](/integrations/builtin/core-nodes/n8n-nodes-base.git.md) execute hooks do Git. |
N8N_POSTMESSAGE_ALLOWED_ORIGINS=  # | String |  | Origens autorizadas a trocar comandos `postMessage` com o editor quando ele está embutido em outra página. Só é relevante quando embutir o editor é possível, por exemplo ao rodar com `N8N_PREVIEW_MODE=true`. Forneça múltiplas origens como uma lista separada por vírgulas, por exemplo `https://n8n.io,https://app.example.com`. Quando vazio (o padrão), o editor aceita mensagens de qualquer origem. |
N8N_SECURITY_POLICY_MANAGED_BY_ENV=  # | Boolean | `false` | Defina como `true` para gerenciar a política de segurança a partir de variáveis de ambiente. Quando `true`, o n8n aplica as variáveis de política de segurança a cada inicialização e bloqueia os controles correspondentes na interface. |
N8N_MFA_ENFORCED_ENABLED=  # | Boolean | `false` | Se deve exigir autenticação de dois fatores para todos os usuários (`true`) ou não (`false`). |
N8N_PERSONAL_SPACE_PUBLISHING_ENABLED=  # | Boolean | `true` | Se os usuários podem publicar a partir de seu espaço pessoal (`true`) ou não (`false`). |
N8N_PERSONAL_SPACE_SHARING_ENABLED=  # | Boolean | `true` | Se os usuários podem compartilhar recursos de seu espaço pessoal (`true`) ou não (`false`). |

# Controle de versão (source control)
N8N_SOURCECONTROL_DEFAULT_SSH_KEY_TYPE=  # | String | `ed25519` | Defina como `rsa` para tornar RSA o tipo padrão de chave SSH para a [configuração do controle de versão](/administer/use-source-control-and-environments/set-up-source-control.md). |

# SSO
N8N_SSO_MANAGED_BY_ENV=  # | Boolean | `false` | Defina como `true` para gerenciar o SSO a partir de variáveis de ambiente. Quando `true`, o n8n aplica as variáveis de SSO a cada inicialização e bloqueia os controles correspondentes na interface. |
N8N_SSO_USER_ROLE_PROVISIONING=  # | Enum string: `disabled`, `instance_role`, `instance_and_project_roles` | `disabled` | Como o n8n provisiona papéis (roles) para usuários que entram via SSO. `disabled` não provisiona nenhum papel. `instance_role` provisiona apenas o papel no nível da instância. `instance_and_project_roles` provisiona tanto os papéis de instância quanto os de projeto. |
N8N_SSO_OIDC_LOGIN_ENABLED=  # | Boolean | `false` | Se deve habilitar o login OIDC. |
N8N_SSO_OIDC_CLIENT_ID=  # | String | - | ID do cliente OIDC emitido pelo seu provedor de identidade. |
N8N_SSO_OIDC_CLIENT_SECRET=  # | String | - | Segredo do cliente OIDC emitido pelo seu provedor de identidade. |
N8N_SSO_OIDC_DISCOVERY_ENDPOINT=  # | String | - | URL do endpoint de descoberta OIDC (a URL `.well-known/openid-configuration` do seu provedor de identidade). |
N8N_SSO_OIDC_PROMPT=  # | String | - | Parâmetro OIDC `prompt` opcional a ser enviado com a requisição de autorização, por exemplo `login` ou `consent`. |
N8N_SSO_OIDC_ACR_VALUES=  # | String | - | Parâmetro OIDC `acr_values` opcional. Use isso para solicitar um contexto de autenticação específico, por exemplo um fluxo de MFA com step-up. |
N8N_SSO_SAML_LOGIN_ENABLED=  # | Boolean | `false` | Se deve habilitar o login SAML. |
N8N_SSO_SAML_METADATA=  # | String | - | Metadados do provedor de identidade SAML como uma string XML. Mutuamente exclusivo com `N8N_SSO_SAML_METADATA_URL`; não defina ambos. |
N8N_SSO_SAML_METADATA_URL=  # | String | - | URL de onde buscar os metadados do provedor de identidade SAML. Mutuamente exclusivo com `N8N_SSO_SAML_METADATA`; não defina ambos. |

# Proteção contra SSRF
N8N_SSRF_PROTECTION_ENABLED=  # | Boolean | `false` | Ativa a proteção contra SSRF para requisições a destinos controláveis pelo usuário. |
N8N_SSRF_BLOCKED_IP_RANGES=  # | String | `default` | Faixas CIDR separadas por vírgulas a bloquear. A palavra-chave `default` (sem diferenciar maiúsculas e minúsculas) expande para o conjunto nativo do n8n. Anexe suas próprias faixas: `default,100.64.0.0/10`. |
N8N_SSRF_ALLOWED_IP_RANGES=  # | String | `-` | Faixas CIDR separadas por vírgulas a permitir. Tem precedência sobre a lista de bloqueio, então use-a para alcançar um host interno conhecido. |
N8N_SSRF_ALLOWED_HOSTNAMES=  # | String | `-` | Nomes de host separados por vírgulas a permitir. Suporta um curinga `*.` no início: `*.internal.example.com` corresponde a qualquer subdomínio, incluindo aninhados, mas não ao domínio puro. A correspondência não diferencia maiúsculas de minúsculas. |
N8N_SSRF_BLOCKED_HOSTNAMES=  # | String | `-` | Nomes de host separados por vírgulas a negar por nome, verificados antes da resolução DNS. Usa o mesmo curinga `*.` no início e a mesma correspondência sem diferenciar maiúsculas e minúsculas de `N8N_SSRF_ALLOWED_HOSTNAMES`. Um nome de host permitido sempre prevalece sobre um bloqueado. |
N8N_SSRF_DNS_CACHE_MAX_SIZE=  # | Number | `1048576` | Tamanho máximo do cache interno de resolução DNS, em bytes (1 MB por padrão). O n8n remove as entradas menos recentemente usadas quando o cache está cheio. |

# Task runners
N8N_RUNNERS_ENABLED=  # (**depreciado**) | Boolean | `false` | Se os task runners estão habilitados. **Depreciado** a partir da v2.0. |
N8N_RUNNERS_MODE=  # (| Enum string: `internal`, `external` | `internal` | Como iniciar e executar o task runner. `internal` significa que o n8n iniciará um task runner como processo filho. `external` significa que um orquestrador externo iniciará o task runner. |
N8N_RUNNERS_AUTH_TOKEN=  # (| String | String aleatória | Segredo compartilhado usado por um task runner para se autenticar no n8n. Obrigatório ao usar o modo `external`. |
N8N_RUNNERS_BROKER_PORT=  # (| Number | `5679` | Porta na qual o task broker escuta as conexões dos task runners. |
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=  # (| String | `127.0.0.1` | Endereço no qual o task broker escuta. |
N8N_RUNNERS_MAX_PAYLOAD=  # (| Number | `1 073 741 824` | Tamanho máximo do payload, em bytes, para a comunicação entre um task broker e um task runner. |
N8N_RUNNERS_MAX_OLD_SPACE_SIZE=  # (| String |  | Opção `--max-old-space-size` a ser usada para um task runner (em MB). Por padrão, o Node.js define isso com base na memória disponível. |
N8N_RUNNERS_MAX_CONCURRENCY=  # (| Number | `5` | Número de tarefas concorrentes que um task runner pode executar ao mesmo tempo. |
N8N_RUNNERS_TASK_TIMEOUT=  # (| Number | `300` | Tempo máximo, em segundos, que uma tarefa pode rodar antes de o runner interrompê-la e reiniciar. Esse valor deve ser maior que 0. |
N8N_RUNNERS_HEARTBEAT_INTERVAL=  # (| Number | `30` | Intervalo, em segundos, no qual o runner deve enviar um heartbeat ao broker. Se o runner não enviar um heartbeat a tempo, a tarefa é interrompida e o runner reinicia. Esse valor deve ser maior que 0. |
N8N_RUNNERS_INSECURE_MODE=  # (| Boolean | `false` | Se deve desabilitar todas as medidas de segurança no task runner, para compatibilidade com módulos que dependem de recursos inseguros do JS. **Desencorajado para uso em produção.** |
N8N_RUNNERS_TASK_REQUEST_TIMEOUT=  # (| Number | `60` | Quanto tempo (em segundos) uma requisição de tarefa pode esperar até que um runner fique disponível antes de expirar. Isso evita que os workflows fiquem travados indefinidamente quando nenhum runner está disponível. Deve ser maior que 0. |
N8N_RUNNERS_LAUNCHER_LOG_LEVEL=  # (| Enum string: `debug`, `info`, `warn`, `error` | `info` | Quais mensagens de log exibir. |
N8N_RUNNERS_AUTH_TOKEN=  # (| String | - | Segredo compartilhado usado para autenticar no n8n. |
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT=  # (| Number | `15` | Número de segundos a esperar antes de desligar um runner ocioso. |
N8N_RUNNERS_TASK_BROKER_URI=  # (| String | `http://127.0.0.1:5679` | URI do servidor do task broker (instância do n8n). |
N8N_RUNNERS_LAUNCHER_HEALTH_CHECK_PORT=  # (| Number | `5680` | Porta para o servidor de verificação de saúde do launcher. |
N8N_RUNNERS_MAX_PAYLOAD=  # (| Number | `1 073 741 824` | Tamanho máximo do payload, em bytes, para a comunicação entre um task broker e um task runner. |
N8N_RUNNERS_MAX_CONCURRENCY=  # (| Number | `5` | Número de tarefas concorrentes que um task runner pode executar ao mesmo tempo. |
N8N_RUNNERS_GRANT_TOKEN=  # (| String | String aleatória | Token que o runner usa para se autenticar no task broker. Isso é fornecido automaticamente pelo launcher. |
N8N_RUNNERS_ID=  # (| String | String aleatória | ID com o qual o runner se identifica ao task broker. No modo `internal`, o n8n o define para cada runner que inicia. No modo `external`, deixe-o indefinido a menos que você precise de IDs estáveis nos logs do broker: cada runner precisa de um valor único, e dois runners compartilhando um ficam se expulsando mutuamente. Defina-o por tipo de runner como um `env-override` no [arquivo de configuração dos runners](/deploy/host-n8n/configure-n8n/set-up-task-runners.md#configuring-launcher-in-runners-container-in-external-mode) (`/etc/n8n-task-runners.json`), não como uma variável de ambiente do container. Disponível a partir do n8n 2.35.0. |
N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT=  # (| Number | `15` | Número de segundos a esperar antes de desligar um runner ocioso. |
N8N_RUNNERS_TASK_BROKER_URI=  # (| String | `http://127.0.0.1:5679` | URI do servidor do task broker (instância do n8n). |
N8N_RUNNERS_LAUNCHER_HEALTH_CHECK_PORT=  # (| Number | `5680` | Porta para o servidor de verificação de saúde do launcher. |
N8N_RUNNERS_MAX_PAYLOAD=  # (| Number | `1 073 741 824` | Tamanho máximo do payload, em bytes, para a comunicação entre um task broker e um task runner. |
N8N_RUNNERS_MAX_CONCURRENCY=  # (| Number | `5` | Número de tarefas concorrentes que um task runner pode executar ao mesmo tempo. |
NODE_FUNCTION_ALLOW_BUILTIN=  # (| String | - | Permite que os usuários importem módulos nativos (built-in) específicos no nó Code. Use \* para permitir todos. O n8n desabilita a importação de módulos por padrão. No modo external, defina isso no [arquivo de configuração dos runners](/deploy/host-n8n/configure-n8n/set-up-task-runners.md#configuring-launcher-in-runners-container-in-external-mode) (`/etc/n8n-task-runners.json`) como um `env-override`, não como uma variável de ambiente do container. |
NODE_FUNCTION_ALLOW_EXTERNAL=  # (| String | - | Permite que os usuários importem módulos externos específicos (de `n8n/node_modules`) no nó Code. O n8n desabilita a importação de módulos por padrão. No modo external, defina isso no [arquivo de configuração dos runners](/deploy/host-n8n/configure-n8n/set-up-task-runners.md#configuring-launcher-in-runners-container-in-external-mode) (`/etc/n8n-task-runners.json`) como um `env-override`, não como uma variável de ambiente do container. |
N8N_RUNNERS_ALLOW_PROTOTYPE_MUTATION=  # (| Boolean | `false` | Se deve permitir a mutação de prototype para bibliotecas externas. Defina como `true` para permitir módulos que dependem de mutação de prototype em tempo de execução (por exemplo, [`puppeteer`](https://pptr.dev/)), ao custo de relaxar a segurança. |
NODE_OPTIONS=  # (| String | - | [Opções](https://nodejs.org/api/cli.html#node_optionsoptions) para o Node.js. |
N8N_RUNNERS_MAX_OLD_SPACE_SIZE=  # (| String |  | Opção `--max-old-space-size` a ser usada para um task runner (em MB). Por padrão, o Node.js define isso com base na memória disponível. |
N8N_RUNNERS_STDLIB_ALLOW=  # (| String | - | Módulos da biblioteca padrão do Python que você pode usar no nó Code, incluindo seus submódulos. Use `*` para permitir todos os módulos da stdlib. O n8n desabilita todas as importações da biblioteca padrão do Python por padrão. No modo external, defina isso no [arquivo de configuração dos runners](/deploy/host-n8n/configure-n8n/set-up-task-runners.md#configuring-launcher-in-runners-container-in-external-mode) (`/etc/n8n-task-runners.json`) como um `env-override`, não como uma variável de ambiente do container. |
N8N_RUNNERS_EXTERNAL_ALLOW=  # (| String | - | Módulos Python de terceiros permitidos para uso no nó Code, incluindo seus submódulos. Use `*` para permitir todos os módulos externos. O n8n desabilita todos os módulos Python de terceiros por padrão. Os módulos Python de terceiros precisam estar [incluídos](/deploy/host-n8n/configure-n8n/set-up-task-runners.md#adding-extra-dependencies) na imagem `n8nio/runners`. No modo external, defina isso no [arquivo de configuração dos runners](/deploy/host-n8n/configure-n8n/set-up-task-runners.md#configuring-launcher-in-runners-container-in-external-mode) (`/etc/n8n-task-runners.json`) como um `env-override`, não como uma variável de ambiente do container. |
N8N_RUNNERS_ALLOW_TRANSITIVE_IMPORTS=  # (| Boolean | `false` | Se as importações feitas pelo próprio código de um pacote na allowlist ignoram a allowlist de importações (tanto `N8N_RUNNERS_EXTERNAL_ALLOW` quanto `N8N_RUNNERS_STDLIB_ALLOW`). Defina como `true` para permitir que um pacote da allowlist carregue o que quer que ele importe (suas dependências transitivas e a stdlib) sem listar cada módulo. Isso ajuda com pacotes cujas importações internas trazem outros módulos (por exemplo, `pandas` importa `pytz`, ou `boto3` importa `dateutil`). Suas próprias importações no nó Code continuam sendo verificadas contra a allowlist. Habilitar isso confia na atividade de importação de todos os pacotes instalados, não apenas nos nomeados: uma dependência comprometida poderia trazer módulos que a allowlist bloquearia de outra forma, então só habilite quando os pacotes instalados na imagem do runner forem confiáveis. No modo external, defina isso no [arquivo de configuração dos runners](/deploy/host-n8n/configure-n8n/set-up-task-runners.md#configuring-launcher-in-runners-container-in-external-mode) (`/etc/n8n-task-runners.json`) como um `env-override`, não como uma variável de ambiente do container. |
N8N_RUNNERS_BUILTINS_DENY=  # (| String | `eval,exec,compile,open,input,breakpoint,getattr,object,type,vars,setattr,delattr,hasattr,dir,memoryview,__build_class__,globals,locals` | Funções nativas (built-ins) do Python que você não pode usar no nó Code. Defina como uma string vazia para permitir todos os built-ins. |
N8N_BLOCK_RUNNER_ENV_ACCESS=  # (| Boolean | `true` | Se deve bloquear o acesso ao ambiente do runner de dentro das tarefas de código Python. Defina como `false` para permitir que todos os usuários do nó Code em Python acessem o ambiente do runner via `os.environ`. Por razões de segurança, o acesso a variáveis de ambiente é bloqueado por padrão. |

# Fuso horário e localização
GENERIC_TIMEZONE=  # | \* | `America/New_York` | Fuso horário da instância do n8n. Importante para nós de agendamento (como o Cron). |
N8N_DEFAULT_LOCALE=  # | String | `en` | Identificador de locale, compatível com o [cabeçalho Accept-Language](https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Accept-Language). O n8n não suporta identificadores regionais, como `de-AT`. Ao rodar em um locale diferente do padrão, o n8n exibe as strings da interface no locale selecionado e recorre a `en` para quaisquer strings não traduzidas. |

# Gerenciamento de usuários e 2FA
N8N_EMAIL_MODE=  # | String | `smtp` | Habilita e-mails. |
N8N_SMTP_HOST=  # | String | - | *nome\_do\_seu\_servidor\_SMTP* |
N8N_SMTP_PORT=  # | Number | - | *porta\_do\_seu\_servidor\_SMTP* |
N8N_SMTP_USER=  # | String | - | *seu\_usuário\_SMTP* |
N8N_SMTP_PASS=  # | String | - | *sua\_senha\_SMTP* |
N8N_SMTP_OAUTH_SERVICE_CLIENT=  # | String | - | Se estiver usando 2LO com uma conta de serviço, este é o seu client ID |
N8N_SMTP_OAUTH_PRIVATE_KEY=  # | String | - | Se estiver usando 2LO com uma conta de serviço, esta é a sua chave privada |
N8N_SMTP_SENDER=  # | String | - | Endereço de e-mail do remetente. Você pode opcionalmente incluir o nome do remetente. Exemplo com nome: *n8n `<contact@n8n.com>`* |
N8N_SMTP_SSL=  # | Boolean | `true` | Se deve usar SSL para SMTP (true) ou não (false). |
N8N_SMTP_STARTTLS=  # | Boolean | `true` | Se deve usar STARTTLS para SMTP (true) ou não (false). |
N8N_UM_EMAIL_TEMPLATES_INVITE=  # | String | - | Caminho completo para o seu template de e-mail em HTML. Isso sobrepõe o template padrão dos e-mails de convite. |
N8N_UM_EMAIL_TEMPLATES_PWRESET=  # | String | - | Caminho completo para o seu template de e-mail em HTML. Isso sobrepõe o template padrão dos e-mails de redefinição de senha. |
N8N_UM_EMAIL_TEMPLATES_WORKFLOW_SHARED=  # | String | - | Sobrepõe o template HTML padrão para notificar usuários de que um workflow foi compartilhado. Forneça o caminho completo para o template. |
N8N_UM_EMAIL_TEMPLATES_CREDENTIALS_SHARED=  # | String | - | Sobrepõe o template HTML padrão para notificar usuários de que uma credencial foi compartilhada. Forneça o caminho completo para o template. |
N8N_UM_EMAIL_TEMPLATES_PROJECT_SHARED=  # | String | - | Sobrepõe o template HTML padrão para notificar usuários de que um projeto foi compartilhado. Forneça o caminho completo para o template. |
N8N_USER_MANAGEMENT_JWT_SECRET=  # | String | - | Define um segredo JWT específico. Por padrão, o n8n gera um na inicialização. |
N8N_USER_MANAGEMENT_JWT_DURATION_HOURS=  # | Number | 168 | Define um prazo de expiração para os JWTs, em horas. |
N8N_USER_MANAGEMENT_JWT_REFRESH_TIMEOUT_HOURS=  # | Number | 0 | Quantas horas antes de o JWT expirar ele deve ser renovado automaticamente. 0 significa 25% de `N8N_USER_MANAGEMENT_JWT_DURATION_HOURS`. -1 significa que ele nunca será renovado, o que força os usuários a fazer login novamente após o período definido em `N8N_USER_MANAGEMENT_JWT_DURATION_HOURS`. |
N8N_MFA_ENABLED=  # | Boolean | `true` | Se deve habilitar a autenticação de dois fatores (true) ou desabilitar (false). O n8n ignora isso se usuários existentes tiverem o 2FA habilitado. |
N8N_INVITE_LINKS_EMAIL_ONLY=  # | Boolean | `false` | Quando definido como true, o n8n entregará os links de convite apenas por e-mail e não os exporá pela API. Essa opção aumenta a segurança ao impedir que as URLs de convite fiquem acessíveis programaticamente ou a usuários com privilégios elevados. |
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=  # | Boolean | `false` | Defina como `true` para gerenciar o proprietário da instância a partir de variáveis de ambiente. Quando `true`, o n8n sobrescreve os dados do proprietário da instância abaixo a cada inicialização, bloqueia o controle da interface para esse usuário e rejeita escritas pela API. |
N8N_INSTANCE_OWNER_EMAIL=  # | String | - | Endereço de e-mail do proprietário da instância. |
N8N_INSTANCE_OWNER_FIRST_NAME=  # | String | - | Primeiro nome do proprietário da instância. |
N8N_INSTANCE_OWNER_LAST_NAME=  # | String | - | Sobrenome do proprietário da instância. |
N8N_INSTANCE_OWNER_PASSWORD_HASH=  # | String | - | Hash bcrypt da senha do proprietário da instância. Definir uma senha em texto puro quebra o login. |

# Workflows
N8N_ONBOARDING_FLOW_DISABLED=  # | Boolean | `false` | Se deve desabilitar as dicas de onboarding ao criar um novo workflow (true) ou não (false). |
N8N_WORKFLOW_ACTIVATION_BATCH_SIZE=  # | Number | `1` | Quantos workflows publicar simultaneamente durante a inicialização. |
N8N_WORKFLOW_CALLER_POLICY_DEFAULT_OPTION=  # | String | `workflowsFromSameOwner` | Quais workflows podem chamar um workflow. As opções são: `any`, `none`, `workflowsFromAList`, `workflowsFromSameOwner`. Este recurso requer [compartilhamento de workflows](/build/manage-workflows/share-with-others.md). |
N8N_WORKFLOW_TAGS_DISABLED=  # | Boolean | `false` | Se deve desabilitar as tags de workflow (true) ou habilitá-las (false). |
WORKFLOWS_DEFAULT_NAME=  # | String | `My workflow` | Nome padrão usado para novos workflows. |

# Histórico de workflows
N8N_WORKFLOW_HISTORY_PRUNE_TIME=  # | Number | `-1` | Por quanto tempo manter as versões do histórico de workflows antes de excluí-las automaticamente (em horas). Defina como `-1` para manter todas as versões indefinidamente. |

# =================================
#             SEARXNG
# =================================
SEARXNG_SECRET=

# =================================
#            CLOUDFLARE
# =================================
TUNNEL_TOKEN=
